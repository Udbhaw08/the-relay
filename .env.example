# Real LLM Provider (GroqCloud - Free tier only)
# Stand-in simulator is used only for explicitly selected offline tests (LLM_PROVIDER=standin)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Pipeline Defaults
DEFAULT_RETRIEVAL_SETTING=setting_b
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=15.0
LOG_LEVEL=INFO
